{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Tilroy",
  "theme": "luma",
  "logo": {
    "light": "/logo/logo-tilroy-kleur.png",
    "dark": "/logo/logo-tilroy-kleur.png",
    "href": "https://www.tilroy.com"
  },
  "favicon": "/favicon.png",
  "colors": {
    "primary": "#008542",
    "dark": "#0A2A18"
  },
  "background": {
    "color": {
      "light": "#FFFFFF"
    }
  },
  "fonts": {
    "heading": {
      "family": "Poppins",
      "weight": 600
    },
    "body": {
      "family": "Roboto",
      "weight": 400
    }
  },
  "appearance": {
    "default": "light",
    "strict": true
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Get Started",
            "pages": [
              "introduction",
              "authentication",
              "api-concepts"
            ]
          },
          {
            "group": "Core Concepts",
            "pages": [
              "concepts/transactions-sales-orders",
              "concepts/stock-model",
              "concepts/pricing-model"
            ]
          },
          {
            "group": "Integration Guides",
            "pages": [
              "guides/erp-integration",
              "guides/stock-transfers",
              "guides/home-delivery",
              "guides/cash-and-financial",
              "guides/webhooks"
            ]
          }
        ]
      },
      {
        "tab": "API Reference",
        "groups": [
          {
            "group": "Overview",
            "pages": [
              "api-reference/overview"
            ]
          },
          {
            "group": "Sales & Orders",
            "pages": [
              "api-reference/sale-api",
              "api-reference/order-api",
              "api-reference/basket-api"
            ]
          },
          {
            "group": "Inventory",
            "pages": [
              "api-reference/stock-api",
              "api-reference/transfer-api",
              "api-reference/product-api"
            ]
          },
          {
            "group": "Pricing & Promotions",
            "pages": [
              "api-reference/price-api",
              "api-reference/promotion-api",
              "api-reference/voucher-api"
            ]
          },
          {
            "group": "Customers & Payments",
            "pages": [
              "api-reference/customer-api",
              "api-reference/payment-request-api",
              "api-reference/authentication-api"
            ]
          },
          {
            "group": "Shop & Operations",
            "pages": [
              "api-reference/shop-api",
              "api-reference/delivery-api",
              "api-reference/shipment-api"
            ]
          }
        ]
      }
    ]
  }
}
