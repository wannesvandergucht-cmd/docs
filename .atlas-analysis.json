  "keyFeatures": [
    "Asynchronous import endpoints for pushing ERP data into Tilroy",
    "Near real-time export endpoints for pulling sales, transfers, and stock movements",
    "Synchronous APIs for customers, vouchers, and baskets",
    "Omnichannel order management: home delivery, click and collect, in-store POS",
    "Multi-level pricing: global, country, and shop-specific price rules",
    "Stock transfer management between distribution centers and stores",
    "Petty cash, cash-up, and money transfer tracking",
    "Promotion and voucher engine with return incentive activations",
    "Paginated export feeds retained for 14 days"
  ],
  "publicApiSurface": [
    "POST /import/products",
